# Base URL for the component registry
# Use http://localhost:3000 for local development
# Use your production URL (e.g., https://your-site.vercel.app) for production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Your registry namespace shown in install commands (defaults to "@componentry")
NEXT_PUBLIC_REGISTRY_NAMESPACE=@componentry

# Google Search Console verification code
# Get this from: https://search.google.com/search-console
# Format: just the code part, not the full meta tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# PostHog analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
